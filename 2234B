#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >>t;

    while (t--) {
        long long n;
        cin >> n;
        int r = n % 12;
        long long a;
        if (r <= 9) a = r;
        else if (r == 11) a = 11;
        else {
            if (n < 22){
                cout << -1 << endl;
                continue;
            }
            a = 22;
        }
        long long b = n - a;
        cout << a << " " << b << endl;
    }
    return 0;
}
